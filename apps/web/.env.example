# Copy to .env.local (git-ignored). See docs/12-DEPLOY.md.

# PostgreSQL (Neon, pooled string ending ?sslmode=require). Check it with `pnpm db:check`.
# Leave empty in local dev to use the embedded PGlite database in .data/
DATABASE_URL=

# Required in production: 32+ random characters
BETTER_AUTH_SECRET=
# Public URL of the site (production), e.g. https://gtm.example.com
BETTER_AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# Optional: "Login with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, local only: pre-generate NPC voices with `pnpm voice:gen`
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
