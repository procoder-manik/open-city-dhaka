# Copy to apps/web/.env.local and fill in. Never commit real values.

# PostgreSQL (Neon free tier). Empty = local embedded database in apps/web/.data (dev only).
# Neon: create a project → copy the pooled connection string (…?sslmode=require)
DATABASE_URL=

# Better Auth — 32+ random characters (e.g. `openssl rand -base64 32`). Required in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Google login: Google Cloud Console → OAuth client (Web) →
# redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash Redis (rate limiting) — used from Phase 6
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public CDN base for game assets (empty = served from /assets)
NEXT_PUBLIC_ASSET_BASE=

# Azure Speech (free F0 tier) — only needed to run `pnpm voice:gen`
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
