{
  "name": "open-city-dhaka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@game/web",
    "build": "turbo run build",
    "start": "pnpm --filter @game/web start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @game/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget": "node tools/asset-pipeline/check-budget.mjs",
    "voice:gen": "node tools/voice-gen/generate.mjs",
    "assets:textures": "node tools/asset-pipeline/fetch-textures.mjs",
    "map:fetch": "node tools/map-builder/fetch-osm.mjs",
    "map:build": "node tools/map-builder/build.mjs",
    "assets:icons": "node tools/asset-pipeline/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
